# The low-ram-browser embedder. Lives in the low-ram-browser repo and is
# linked into the Chromium checkout as //lrb (build/link_lrb.sh).
#
# Started from content_shell; the parts lrb uses are copied in (trimmed of
# web tests, test hooks and other platforms: lrb/browser/shell.h, the
# clients, main parts, browser context), so lrb links nothing of
# //content/shell but its resource pak.

import("//build/rust/rust_static_library.gni")
import("//tools/grit/repack.gni")
import("//testing/test.gni")

