+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_MEMORY_PRESSURE_SYSTEM_MEMORY_PRESSURE_EVALUATOR_LINUX_H_
+#define COMPONENTS_MEMORY_PRESSURE_SYSTEM_MEMORY_PRESSURE_EVALUATOR_LINUX_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/feature_list.h"
+#include "base/files/file_path.h"
+#include "base/sequence_checker.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "components/memory_pressure/system_memory_pressure_evaluator.h"
+
+namespace memory_pressure::os_linux {
+
+// Enables the Linux evaluator. Params (percent of the applicable limit left
+// before a level engages; poll period; PSI escalation) are tunable with
+// --enable-features=LinuxMemoryPressureEvaluator:moderate_percent/20/...
+BASE_DECLARE_FEATURE(kLinuxMemoryPressureEvaluator);
+
+// One memory budget the browser lives under: a cgroup v2 limit (memory.max
+// or memory.high) on the browser's cgroup or an ancestor, or the whole
+// system (/proc/meminfo).
+struct MemoryBudget {
+  std::string name;  // "cgroup:<path>" or "system"
+  int64_t limit = 0;      // bytes
+  int64_t available = 0;  // bytes left before the limit, counting
+                          // reclaimable page cache as free
+};
+
+struct MemorySnapshot {
+  std::vector<MemoryBudget> budgets;
+  // PSI "some avg10" for memory (percent of time some task stalled on
+  // memory over the last 10 s), from the nearest cgroup or /proc/pressure.
+  // Negative when unavailable.
+  double psi_some_avg10 = -1;
+};
+
+// Polls the browser's memory budgets and votes on memory pressure.
+//
+// //content has no memory pressure source on Linux, so without this the
+// browser never frees caches before the kernel's OOM killer ends it. The
+// budget that matters is often a cgroup limit (systemd scopes, containers,
+// --memory-max in tests), not system RAM, so both are checked and the
+// tightest wins.
+class SystemMemoryPressureEvaluator
+    : public memory_pressure::SystemMemoryPressureEvaluator {
+ public:
+  explicit SystemMemoryPressureEvaluator(
+      std::unique_ptr<MemoryPressureVoter> voter);
+  ~SystemMemoryPressureEvaluator() override;
+
+  SystemMemoryPressureEvaluator(const SystemMemoryPressureEvaluator&) = delete;
+  SystemMemoryPressureEvaluator& operator=(
+      const SystemMemoryPressureEvaluator&) = delete;
+
+  // Reads the budgets of the calling process. `sysfs_cgroup_root` is normally
+  // /sys/fs/cgroup and `procfs_root` /proc; both are parameters for tests.
+  // Only kernel files are read, without blocking, so it runs on the
+  // evaluator's own sequence.
+  static MemorySnapshot TakeSnapshot(const base::FilePath& sysfs_cgroup_root,
+                                     const base::FilePath& procfs_root);
+
+  // The pressure level a snapshot implies: the worst level over all budgets,
+  // raised to at least moderate when PSI shows sustained stalls.
+  static base::MemoryPressureLevel LevelFor(const MemorySnapshot& snapshot,
+                                            int moderate_percent,
+                                            int critical_percent,
+                                            double psi_moderate_avg10);
+
+ private:
+  void Poll();
+
+  const int moderate_percent_;
+  const int critical_percent_;
+  const double psi_moderate_avg10_;
+
+  base::RepeatingTimer timer_;
+  base::TimeTicks last_notification_;
+
+  SEQUENCE_CHECKER(sequence_checker_);
+};
+
+}  // namespace memory_pressure::os_linux
+
+#endif  // COMPONENTS_MEMORY_PRESSURE_SYSTEM_MEMORY_PRESSURE_EVALUATOR_LINUX_H_
