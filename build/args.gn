# Phase 1 build: stock content_shell, size-focused release build.
# No source patches yet: this isolates what build configuration alone saves,
# compared against the Phase 0 snapshot of the same commit.
# target_cpu is appended by build/build.sh. Every arg below was checked to
# exist at CHROMIUM_COMMIT.

is_debug = false
is_official_build = true        # ThinLTO, CFI, PGO (needs checkout_pgo_profiles)
is_component_build = false
dcheck_always_on = false

# No debug info in the shipped binary. Doesn't change resident memory much
# (symbols aren't loaded), but makes binaries copyable to small devices.
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0

# Features a minimal browser drops.
enable_pdf = false
# Printing only to a PDF file, with no dialog or preview (lrb/browser/
# print.h): print preview is a WebUI page and needs the PDF viewer, CUPS
# printing needs Chrome's dialogs.
enable_printing = true
enable_print_preview = false
use_cups = false
# Chrome's enterprise watermarks on printouts; it pulls in the PDF viewer.
enterprise_watermark = false
enable_widevine = false          # no DRM: Netflix/Spotify web won't play
enable_vr = false
enable_remoting = false
use_kerberos = false
enable_mdns = false

# GTK is dlopen'd for theming and file dialogs and costs resident memory.
# Off to measure; the browser will need its own (or a portal) file chooser.
use_gtk = false

# Mainstream video still needs H.264/AAC. Patent licensing applies when
# distributing; see docs/building.md.
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# Build-time only. V8's metagen step runs its own `gn desc` in a temporary
# directory, without this build's --root-target, so it loads the whole
# tree, where //chrome targets assert the features dropped above, and
# fails; false selects V8's older path for the same generated code. The
# switch's name moves: none in M154, v8_use_metagen_instance_types in M155
# and M156, v8_use_metagen since M157 (v8/gni/v8.gni). GN only warns "no
# effect" for a name it doesn't know, and the build then fails at
# //v8:run_metagen with `assert(enable_print_preview)`.
v8_use_metagen = false

# Keep: V8 sandbox (default on 64-bit), WebAssembly, dav1d (AV1 on YouTube).
