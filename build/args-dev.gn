# Development overrides, appended after build/args.gn by `build/build.sh <cpu> dev`.
# Same features as the measured build, but fast incremental rebuilds for
# writing patches: no ThinLTO/PGO, shared libraries, DCHECKs on to catch
# patch bugs early. Never measure memory with this build.
is_official_build = false
is_component_build = true
dcheck_always_on = true
symbol_level = 1                 # function names and line numbers in stack traces
blink_symbol_level = 1
v8_symbol_level = 1
